---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import { projects } from '../../data/projects';
---
<SiteLayout title="Projects — Simon Gelbart" current="work">
  <section class="page-heading narrow">
    <p class="eyebrow">Projects</p>
    <h1>The full list, with honest status.</h1>
    <p class="lede">A short index of the public work. The repositories contain the details; this page gives you the context first.</p>
  </section>

  <section class="project-list" aria-label="Projects">
    {projects.map((project) => <ProjectRow project={project} />)}
  </section>

  <section class="section section-compact">
    <div class="note">This list is intentionally small. If a repository is not here, the GitHub profile is the better place to find it.</div>
  </section>
</SiteLayout>
