---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { archivedProjects, currentProjects, selectedProjects } from '../data/projects';
---
<SiteLayout current="home">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Simon Gelbart · France</p>
      <h1>Backend systems, tools, and learning material — built in public.</h1>
      <p class="lede">I’m a senior backend developer working mostly with .NET and C#. This is the short version of what I’m building, exploring, and learning.</p>
      <div class="actions">
        <a class="button button-primary" href="#now">What I’m working on</a>
        <a class="button" href="https://github.com/SimonGelbart" rel="noreferrer">Open GitHub ↗</a>
      </div>
    </div>
    <aside class="hero-note">
      <span class="status-line"><span class="status-dot" aria-hidden="true"></span> Public work in progress</span>
      <h2>Current focus</h2>
      <p>Backend architecture, testing, developer tooling, and ways to make technical decisions easier to see.</p>
      <div class="hero-note__tags">
        <span>.NET / C#</span>
        <span>TypeScript</span>
        <span>Python</span>
      </div>
    </aside>
  </section>

  <section class="section" id="now">
    <div class="section-heading">
      <p class="eyebrow">Now</p>
      <h2>What I’m working on</h2>
      <p>A small set of active projects. Some are useful already; some are still being figured out.</p>
    </div>
    <div class="project-grid project-grid--current">
      {currentProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="section section-rule" id="work">
    <div class="section-heading section-heading--split">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2>A few things worth looking at</h2>
      </div>
      <a class="text-link" href="/projects/">See all projects →</a>
    </div>
    <div class="project-grid">
      {selectedProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="section section-rule">
    <div class="section-heading">
      <p class="eyebrow">Past experiments</p>
      <h2>Useful tests, not active commitments.</h2>
      <p>Pattrn and LORQ are kept visible because they were useful testing fields. They are no longer part of my current focus.</p>
    </div>
    <div class="archive-list">
      {archivedProjects.map((project) => (
        <article class={`archive-row accent-${project.accent}`}>
          <div>
            <p class="eyebrow">{project.eyebrow}</p>
            <h3>{project.name}</h3>
          </div>
          <p>{project.summary}</p>
          <a class="text-link" href={project.links[0].href} rel="noreferrer">Repository ↗</a>
        </article>
      ))}
    </div>
  </section>

  <section class="section split">
    <div>
      <p class="eyebrow">How I work</p>
      <h2>Make the important parts visible.</h2>
    </div>
    <div class="about-copy">
      <p>I like backend work that has clear boundaries, predictable behavior, and tests that explain the decisions behind the code.</p>
      <p>When an idea is worth sharing, I turn it into a library, a small tool, a learning path, or a note that someone else can inspect.</p>
      <a class="text-link" href="/about">A little more about me →</a>
    </div>
  </section>

  <section class="follow-card">
    <div>
      <p class="eyebrow">Follow along</p>
      <h2>The most current version is on GitHub.</h2>
      <p>I keep the repositories as the source of truth. This page is just the map.</p>
    </div>
    <a class="button button-primary" href="https://github.com/SimonGelbart" rel="noreferrer">Visit GitHub ↗</a>
  </section>
</SiteLayout>
