---
import SiteLayout from '../../layouts/SiteLayout.astro';
import LearningCard from '../../components/LearningCard.astro';
import { learningPaths } from '../../data/learningPaths';
---
<SiteLayout title="Learning — Simon Gelbart">
  <section class="page-heading narrow">
    <p class="eyebrow">Learning</p>
    <h1>Teaching is part of the work.</h1>
    <p class="lede">I use short lessons, examples, and decision guides to make backend design topics easier to reason about.</p>
  </section>

  <section class="section">
    {learningPaths.map((path) => <LearningCard path={path} featured showStatusText />)}
  </section>
</SiteLayout>
