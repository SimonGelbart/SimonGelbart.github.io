---
const { project } = Astro.props;
---
<article class={`project-row accent-${project.accent}`}>
  <div class="project-row__body">
    <div class="project-card__top">
      <span class="eyebrow">{project.eyebrow}</span>
      <span class="status-chip">{project.status}</span>
    </div>
    <h2>{project.name}</h2>
    <p class="project-row__summary">{project.summary}</p>
    <p>{project.description}</p>
  </div>
  <aside class="project-row__aside">
    <span class="meta-line">Stack</span>
    <strong>{project.stack}</strong>
    <div class="quiet-actions" aria-label={`${project.name} links`}>
      {project.links.map((link, index) => (
        <>
          <a href={link.href} rel={link.external ? 'noreferrer' : undefined}>{link.label}</a>
          {index < project.links.length - 1 && <span aria-hidden="true">·</span>}
        </>
      ))}
    </div>
  </aside>
</article>
