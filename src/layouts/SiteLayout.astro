---
import '../styles/site.css';
const {
  title = 'Simon Gelbart — Backend developer',
  description = 'A small portfolio of Simon Gelbart\'s backend projects, experiments, and learning material.',
  current = '',
} = Astro.props;
const nav = [
  { href: '/#work', label: 'Work', key: 'work' },
  { href: '/#now', label: 'Now', key: 'now' },
  { href: '/about', label: 'About', key: 'about' },
  { href: 'https://github.com/SimonGelbart', label: 'GitHub ↗', key: 'github', external: true },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-current={current === 'home' ? 'page' : undefined}>Simon Gelbart</a>
      <nav class="desktop-nav" aria-label="Main navigation">
        {nav.map((item) => <a href={item.href} aria-current={current === item.key ? 'page' : undefined} rel={item.external ? 'noreferrer' : undefined}>{item.label}</a>)}
      </nav>
      <details class="mobile-nav">
        <summary>Menu</summary>
        <div class="mobile-nav__panel">
          {nav.map((item) => <a href={item.href} rel={item.external ? 'noreferrer' : undefined}>{item.label}</a>)}
        </div>
      </details>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <span>Simon Gelbart</span>
      <span>Backend systems · tools · learning material</span>
      <a href="https://github.com/SimonGelbart" rel="noreferrer">GitHub ↗</a>
    </footer>
  </body>
</html>
